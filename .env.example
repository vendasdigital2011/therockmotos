# Copie para .env (local) ou configure em Vercel > Settings > Environment Variables.
# Nunca versionar o .env.

# Supabase > Project Settings > Database > Connection string
# App (pooler, porta 6543):
DATABASE_URL="postgresql://postgres.[ref]:[SENHA]@aws-0-[regiao].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations (direta, porta 5432):
DIRECT_URL="postgresql://postgres.[ref]:[SENHA]@aws-0-[regiao].pooler.supabase.com:5432/postgres"

# Segredo para assinar cookies de sessão (mín. 32 caracteres). Gerar com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Modo demo: "true" mostra aviso de dados fictícios e de integrações simuladas.
DEMO_MODE=true

# Chaves dos portais (seed_portals.js). Deixe vazio se não usar a integração.
WEBMOTORS_API_KEY=
OLX_API_KEY=
ICARROS_API_KEY=
MERCADOLIVRE_API_KEY=

# Segredo do webhook bancário (mínimo 32 caracteres). Sem ele, o endpoint fica desativado.
BANK_WEBHOOK_SECRET=
